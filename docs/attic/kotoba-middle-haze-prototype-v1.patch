diff --git a/src/styles/avatar.css b/src/styles/avatar.css
index a3cc68b..372f9f7 100644
--- a/src/styles/avatar.css
+++ b/src/styles/avatar.css
@@ -1009,3 +1009,102 @@
     --avatar-fade-y: calc(84% / var(--avatar-scale, 1));
   }
 }
+
+/*
+ * ---- 中学生の一覧だけ：人物の周りの白いくもり（試作） ----
+ *
+ * 見本（IMG_5361(1).jpeg）の仕上がりに寄せる。範囲の参考は IMG_5360(2).jpeg の
+ * ピンクで、ピンク色そのものは実装しない。
+ *
+ * やり方
+ *   同じ人物画像をもう一枚、白一色にして（brightness(0) invert(1)）ぼかし、
+ *   人物の後ろへ敷く。形は人物の輪郭そのものなので、肩や服のでこぼこに沿って
+ *   不均一に広がり、外へ行くほど薄れてカードの淡い面へ溶ける。
+ *   円・楕円の地色ではなく、一定幅の縁取りでも、輪郭を囲む光の輪でもない。
+ *
+ * 守っていること
+ *   ・人物そのものには何も掛けない（後ろに敷くだけ）。顔・目・髪は鮮明なまま。
+ *   ・人物全体を白く薄めない。白が見えるのは、人物の外側と、
+ *     もともと半透明に落としてある肩・服の外縁だけ。
+ *   ・名前はこのくもりより手前（z-index 2）にあり、ぼかさない。
+ *   ・元画像・人物の大きさ・位置・カードの寸法は変えていない。
+ *   ・中学生のカード（data-age="middle"）の一覧だけ。ほかの年代と、
+ *     ほかの画面の丸いサムネイルには出さない（既定は display: none）。
+ */
+.avatar-thumb__haze {
+  display: none;
+}
+
+.avatar-list .avatar-card[data-age='middle'] .avatar-thumb__haze.is-on {
+  display: block;
+  /*
+   * 置きかたは人物の顔（.avatar-thumb__face.has-image）と同じ。
+   * 同じ変数を使うので、頭のてっぺんの位置も表示倍率もぴったり重なる。
+   */
+  position: absolute;
+  left: 0;
+  right: 0;
+  top: 0;
+  aspect-ratio: 1 / 1;
+  margin-top: calc(var(--avatar-head-shift, 0) * 1%);
+  transform: scale(var(--avatar-scale, 1));
+  transform-origin: top center;
+  /* 重なり順は、人物より前・名前（z-index 2）より後ろ。 */
+  z-index: 1;
+  pointer-events: none;
+  /*
+   * 顔・目・髪の中心には、くもりを掛けない。
+   *
+   * 顔を中心にした縦長の楕円の内側を抜いてある。中心から外へ出るほど強くなり、
+   * 肩の外側・服の左右と下端・人物の外側で全面に掛かる。
+   * 胸の中心（赤いリボン）も抜ける位置に合わせてある。
+   *
+   * このなじませは外側の要素に置き、ぼかしは中の要素（::before）に置く。
+   * 同じ要素にまとめると、ぼかしが先に掛かって抜いた穴を埋めてしまう。
+   */
+  -webkit-mask-image: radial-gradient(
+    42% 62% at 50% 40%,
+    rgba(0, 0, 0, 0) 0%,
+    rgba(0, 0, 0, 0) 66%,
+    rgba(0, 0, 0, 0.18) 80%,
+    rgba(0, 0, 0, 0.55) 93%,
+    rgba(0, 0, 0, 0.8) 100%
+  );
+  mask-image: radial-gradient(
+    42% 62% at 50% 40%,
+    rgba(0, 0, 0, 0) 0%,
+    rgba(0, 0, 0, 0) 66%,
+    rgba(0, 0, 0, 0.18) 80%,
+    rgba(0, 0, 0, 0.55) 93%,
+    rgba(0, 0, 0, 0.8) 100%
+  );
+  -webkit-mask-repeat: no-repeat;
+  mask-repeat: no-repeat;
+}
+
+/*
+ * くもりそのもの。人物の画像を白一色にして、ぼかしと白い影を重ねる。
+ *   blur        … 輪郭のすぐ外に、濃いめのくもり
+ *   drop-shadow … その外側へ、薄いくもりを2段で広げる
+ * 影は「ぼかしたあとの白い形」から作られるので、人物の形のまま広がる。
+ * 太さは場所ごとに変わり、一定幅の縁取りや光の輪にはならない。
+ */
+.avatar-list .avatar-card[data-age='middle'] .avatar-thumb__haze.is-on::before {
+  content: '';
+  position: absolute;
+  inset: 0;
+  /* 親に置いた url（人物の画像）をそのまま受け継ぐ。 */
+  background-image: inherit;
+  background-repeat: no-repeat;
+  background-position: center top;
+  background-size: contain;
+  /* ぼかしで外へ広がるぶんを見込んで、少しだけ小さく敷く。 */
+  transform: scale(0.96);
+  transform-origin: top center;
+  filter:
+    brightness(0) invert(1) blur(5px)
+    drop-shadow(0 0 5px rgba(255, 255, 255, 0.95))
+    drop-shadow(0 1px 10px rgba(255, 255, 255, 0.8));
+  opacity: 0.85;
+}
+
